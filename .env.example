COEX_ENV=development
DJANGO_SECRET_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Production requires PostgreSQL and a random secret; use your actual domain.
# DATABASE_URL=postgresql://...
# DJANGO_ALLOWED_HOSTS=your-domain.example
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
DAILY_USER_MESSAGES=50
DAILY_SITE_MESSAGES=500

# Optional provider model overrides; account access and pricing vary.
GEMINI_SEARCH_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
